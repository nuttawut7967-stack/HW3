      },
      "source": [
        "# Convert 'age' column to numeric, coercing errors to NaN\n",
        "data_covid['age'] = pd.to_numeric(data_covid['age'], errors='coerce')\n",
        "\n",
        "# Question 1: Calculate the average age of females and males for all data\n",
        "female_male_avg_age = data_covid.groupby('sex')['age'].mean()\n",
        "print(\"1. Average age by sex for all data:\")\n",
        "print(female_male_avg_age)\n",
        "\n",
        "# Question 2: Calculate the average age of females and males for patients in Khon Kaen province\n",
        "khonkaen_data = data_covid[data_covid['province_of_isolation'] == 'ขอนแก่น']\n",
        "khonkaen_avg_age = khonkaen_data.groupby('sex')['age'].mean()\n",
        "print(\"\\n2. Average age by sex for patients in Khon Kaen:\")\n",
        "print(khonkaen_avg_age)\n",
        "\n",
        "# Question 3: Find the number of patients who are 'คนต่างชาติเดินทางมาจากต่างประเทศ'\n",
        "foreign_travelers_count = data_covid[data_covid['risk'] == 'คนต่างชาติเดินทางมาจากต่างประเทศ'].shape[0]\n",
        "print(\"\\n3. Number of patients who are 'คนต่างชาติเดินทางมาจากต่างประเทศ':\", foreign_travelers_count)\n"
      ],
