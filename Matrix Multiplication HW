      "source": [
        "##(2,3)*(3,2)"
      ],
      "metadata": {
        "id": "xciuys_L_ZdZ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "mat1 = numpy.array([[2,4,6],[3,5,7]])\n",
        "mat2 = numpy.array([[3,4],[3,5],[3,6]])"
      ],
      "metadata": {
        "id": "lK2NowDt6hOi"
      },
      "execution_count": 13,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def mat_mul(A,B):\n",
        "    C = numpy.zeros((A.shape[0],B.shape[1]))#เตรียมขนาดของ matrix ผลลัพธ์\n",
        "    for r_a in range(A.shape[0]):\n",
        "        for c_b in range(B.shape[1]):\n",
        "            for every_element in range(A.shape[1]):\n",
        "                C[r_a,c_b] = C[r_a,c_b] + (A[r_a,every_element] * B[every_element,c_b])\n",
        "    return C"
      ],
      "metadata": {
        "id": "myQSOW05-ZTC"
      },
      "execution_count": 15,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "mat_mul(mat1,mat2)"
      ],
